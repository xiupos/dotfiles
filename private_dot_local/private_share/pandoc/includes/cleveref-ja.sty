%%% START OF cleveref-ja.sty

% cleveref の日本語化
% \Crefname も与える (既定の先頭大文字化は和文でエラーになる)
\newcommand*\crefjaname[2]{\crefname{#1}{#2}{#2}\Crefname{#1}{#2}{#2}}
% 章・節は書式を丸ごと定義する: 第 1 章と第 2 章, 第 1 章から第 3 章
% (区切りの語は和文に挟まれるので空きなし. 番号に挟まれる図・表・式用の区切りは下で定義)
\newcommand*\crefjalabel[3]{\crefjalabelfor{cref}{#1}{#2}{#3}\crefjalabelfor{Cref}{#1}{#2}{#3}}
\newcommand*\crefjalabelfor[4]{%
  \csname#1format\endcsname{#2}{#3~##2##1##3~#4}%
  \csname#1rangeformat\endcsname{#2}{#3~##3##1##4~#4から#3~##5##2##6~#4}%
  \csname#1multiformat\endcsname{#2}{#3~##2##1##3~#4}{と#3~##2##1##3~#4}%
    {, #3~##2##1##3~#4}{, および#3~##2##1##3~#4}%
  \csname#1rangemultiformat\endcsname{#2}{#3~##3##1##4~#4から#3~##5##2##6~#4}%
    {と#3~##3##1##4~#4から#3~##5##2##6~#4}{, #3~##3##1##4~#4から#3~##5##2##6~#4}%
    {, および#3~##3##1##4~#4から#3~##5##2##6~#4}%
}

\AddToHook{package/cleveref/after}{%
  \crefjaname{figure}{図}%
  \crefjaname{table}{表}%
  \crefjaname{equation}{式}%
  \crefjaname{listing}{コード}%
  \crefjaname{appendix}{付録}%
  \crefjaname{subappendix}{付録}%
  \crefjalabel{chapter}{第}{章}%
  \crefjalabel{section}{第}{節}%
  \crefjalabel{subsection}{第}{節}%
  \crefjalabel{subsubsection}{第}{節}%
}

\AtBeginDocument{%
  \renewcommand\crefpairconjunction{\jathinspace と\jathinspace}%
  \renewcommand\crefmiddleconjunction{, }%
  \renewcommand\creflastconjunction{, および\jathinspace}%
  \renewcommand\crefrangeconjunction{\jathinspace から\jathinspace}%
  \renewcommand\crefpairgroupconjunction{と}%
  \renewcommand\crefmiddlegroupconjunction{, }%
  \renewcommand\creflastgroupconjunction{, および}%
}

%%% END OF cleveref-ja.sty
