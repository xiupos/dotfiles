%%% START OF font-ja.sty

% pdfLaTeX (bxcjkjatype) で源ノ明朝・源ノ角ゴシック (Source Han TrueType) を使う。
% TTF は .chezmoiexternal.toml で TEXMFHOME に配置する。
\ifdefined\setminchofont
  \setminchofont{SourceHanSerifJP-Regular.ttf}
  \setboldminchofont{SourceHanSansJP-Medium.ttf} % 太字はゴシックにする
  \setgothicfont{SourceHanSansJP-Regular.ttf}
  \setboldgothicfont{SourceHanSansJP-Medium.ttf}
\fi

%%% END OF font-ja.sty
