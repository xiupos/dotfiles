{
  "name": "pandoc-figure",
  "displayName": "Pandoc Figures in Markdown Preview",
  "description": "Show Pandoc implicit figures (an image alone in a paragraph) with their alt text as a Markdown caption, and apply {#id width=...} image attributes, in the built-in Markdown preview.",
  "version": "0.1.0",
  "publisher": "xiupos",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiupos/dotfiles.git",
    "directory": "vscode-extensions/pandoc-figure"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p . && tsc -p test",
    "test": "../scripts/test-integration.sh pandoc-figure",
    "package": "npm run build && vsce package --no-dependencies --skip-license -o dist/pandoc-figure.vsix"
  }
}
